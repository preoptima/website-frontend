# Sanity (defaults are set in nuxt.config.ts; override per environment if needed)
NUXT_PUBLIC_SANITY_PROJECT_ID=zfe5m87l
NUXT_PUBLIC_SANITY_DATASET=production

# Public URL of the site, used for canonical/OG URLs
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Show dashed placeholders where an image hasn't been added yet (test host only)
NUXT_PUBLIC_SHOW_PLACEHOLDERS=true
